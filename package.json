{
  "name": "screencheck",
  "version": "0.1.0",
  "description": "Localhost design review: pin feedback on live screens and versioned captures, then let coding agents reply.",
  "keywords": [
    "design-review",
    "screenshots",
    "feedback",
    "annotations",
    "playwright",
    "mcp",
    "localhost"
  ],
  "license": "MIT",
  "author": "Alex Selig",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexselig/screencheck.git"
  },
  "homepage": "https://screencheck.dev/",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "screencheck": "dist/cli.js"
  },
  "exports": {
    "./capture": {
      "types": "./dist/types/full-page.d.ts",
      "import": "./dist/capture.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "demo",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/server/main.ts",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test",
    "playground": "node scripts/playground/run.mjs",
    "screencheck": "tsx src/cli/bin.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.1.5"
  },
  "peerDependencies": {
    "playwright": ">=1.40.0",
    "sharp": "^0.35.5"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "playwright": "^1.55.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
